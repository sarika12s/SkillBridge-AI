# ==============================================================================
# SkillBridge AI: Environment Configuration Template
# Official Title: Semantic Resume - Job Matching and Skill Gap Analysis with Personalized Learning Path Recommendation
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="SkillBridge AI"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Connection (PostgreSQL 16 + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skillbridge_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillbridge_db

# Security & Authentication (Argon2id / Bcrypt + JWT)
# Generate a secure 32-byte secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_TO_A_SECURE_RANDOM_HEX_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Configuration
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB
UPLOAD_DIR=./uploads

# NLP & Embedding Model Cache
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
